{
	"name": "lychee-mobile",
	"version": "0.1.0",
	"private": true,
	"description": "Mobile app for Lychee photo management, for iOS and Android (Capacitor + Ionic Vue)",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json --skipLibCheck",
		"sync": "vp build && cap sync",
		"android": "vp build && cap run android",
		"android:live": "node scripts/live-reload.mjs android",
		"ios": "vp build && cap run ios",
		"ios:live": "node scripts/live-reload.mjs ios",
		"open:android": "cap open android",
		"open:ios": "cap open ios"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@capacitor/ios": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"@capawesome/capacitor-file-picker": "8.1.0",
		"@ionic/vue": "^9.0.8",
		"@ionic/vue-router": "^9.0.8",
		"ionicons": "^8.1.0",
		"swiper": "14.3.0",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.5.1",
		"jsdom": "^30.1.2",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0",
		"vue-tsc": "^3.3.13"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
	}
}
